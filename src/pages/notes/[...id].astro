---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getNotes } from '../../lib/content';
import { formatDate, slugifyTag } from '../../lib/site';
export async function getStaticPaths() {
  return (await getNotes()).map((note) => ({ params: { id: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
const { title, publishDate, tags, link } = note.data;
---
<Base title={title} description={(note.body ?? '').slice(0, 160)} type="article" publishDate={publishDate} tags={tags}>
  <article class="prose" style="padding-top:3rem" data-pagefind-body>
    <p class="small muted"><a href="/notes/">Notes</a> · <time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time></p>
    <h1>{link ? <a href={link}>{title} ↗</a> : title}</h1>
    <Content />
    <div class="tags">{tags.map((t) => <a class="tag" href={`/tags/${slugifyTag(t)}/`}>{t}</a>)}</div>
  </article>
</Base>
